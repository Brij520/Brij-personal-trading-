# Copy to .env and edit. NEVER commit .env.
# The application runs with no configuration at all in demo mode.

# ---------------------------------------------------------------- data layer
# demo = deterministic synthetic data (default, no network)
# auto = try real providers, fall back to synthetic and label the fallback
# live = real providers only; any failure is an error, never a silent substitute
BTI_DATA_MODE=demo
BTI_ENVIRONMENT=development
BTI_HISTORICAL_YEARS=5
# BTI_DATA_DIR=./var

# --------------------------------------------------------------- risk limits
# PLATFORM DEFAULTS. These are not Brij's personal limits — set them yourself.
BTI_MAX_POSITION_RISK_PCT=2.0
BTI_MAX_PORTFOLIO_HEAT_PCT=6.0
BTI_MAX_SINGLE_STOCK_PCT=15.0
BTI_MAX_SECTOR_PCT=35.0
BTI_DAILY_LOSS_LIMIT_PCT=3.0
BTI_MIN_REWARD_RISK=1.5

# ------------------------------------------------------- LLM (optional, prose)
# The platform works fully without an LLM using its deterministic rule engines.
# An LLM only phrases findings; it never produces numbers.
BTI_LLM_PROVIDER=none
# BTI_LLM_API_KEY=
# BTI_LLM_MODEL=
# BTI_LLM_BASE_URL=

# ------------------------------------- read-only broker credentials (optional)
# These are used for nothing in this release: no broker call is implemented.
# They exist so future read-only analysis can be added without schema changes.
# BTI_ZERODHA_API_KEY=
# BTI_ZERODHA_ACCESS_TOKEN=
# BTI_DHAN_ACCESS_TOKEN=
# BTI_GROWW_ACCESS_TOKEN=

# ------------------------------------------------------------------- serving
# BTI_CORS_ORIGINS=*
# BTI_LOG_LEVEL=INFO
# BTI_LOG_FILE=./var/logs/bti.log

# ------------------------------------------------------------------- SAFETY
# The following are NOT settings. Setting any of them to a truthy value makes
# the application refuse to start:
#   LIVE_TRADING, AUTO_EXECUTION, AUTO_ORDER_PLACEMENT, FNO_ENABLED
